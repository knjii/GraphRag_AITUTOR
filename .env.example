# Конфигурация rag_textbook. Скопируйте в .env и поправьте под своё окружение.
# Пустое значение переменной означает «не задано» и приводит к значению по умолчанию.

# ---------------------------------------------------------------- каталоги
PDF_DIR=documents/pdf_docs
MARKDOWN_DIR=documents/markdown_docs
# Результат разбора MinerU. Намеренно отделён от MARKDOWN_DIR:
# раньше это был один каталог, и сгенерированные .md рисковали попасть в индекс повторно.
PARSED_DIR=artifacts/parsed
CACHE_DIR=artifacts/cache
MANIFEST_DIR=artifacts/manifests
METRICS_DIR=artifacts/metrics
GOLDSET_DIR=evaluation/goldsets
STATE_DIR=artifacts/state

LOG_LEVEL=INFO
LOG_JSON=0

# ------------------------------------------------------------------ разбор
# pipeline — стабильный и нетребовательный; hybrid быстрее (в MinerU 3.3+ это дефолт);
# vlm точнее на таблицах, но требует около 8 ГБ видеопамяти.
MINERU_BACKEND=pipeline
# Именно east_slavic: значения "ru" MinerU не знает и падает с кодом 2.
MINERU_LANG=east_slavic
MINERU_METHOD=auto
MINERU_FORMULA_ENABLE=1
MINERU_TABLE_ENABLE=1
MINERU_MODEL_SOURCE=huggingface
# MINERU_LOCAL_PIPELINE_MODELS_DIR=/path/to/PDF-Extract-Kit-1.0
MINERU_STALL_TIMEOUT_SECONDS=900

# ----------------------------------------------------------------- чанкинг
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
CHUNKER_STICKY_HEADERS=1
CHUNKER_ENRICH_ENABLED=1
# Только иллюстрации: формулы и таблицы MinerU уже отдаёт как LaTeX и HTML,
# вызывать на них модель зрения — двойная работа и потеря исходного представления.
CHUNKER_ENRICH_TYPES=image,chart
CHUNKER_ENRICH_CACHE_ENABLED=1
CHUNKER_ENRICH_MAX_CONCURRENCY=2

# ------------------------------------------------------------- индексация
# stage — обход по стадиям: сначала разбираются все документы, потом все
#   обогащаются и так далее. Батчи крупные, на карте в каждый момент один
#   потребитель — выше утилизация и ниже риск нехватки памяти.
# document — по документу целиком. Экономнее по оперативной памяти.
INDEXING_MODE=stage
INDEXING_EMBED_WINDOW=1024
INDEXING_CPU_WORKERS=4

# Страховка от нехватки видеопамяти. Позволяет держать крупные батчи:
# при ошибке батч делится пополам и нагрузка стадии снижается автоматически.
INDEXING_VRAM_GUARD_ENABLED=1
INDEXING_MIN_FREE_VRAM_MIB=1536
INDEXING_VRAM_WAIT_SECONDS=120
INDEXING_PARSE_REQUIRED_VRAM_MIB=7000
# Оценка расхода памяти на элемент батча эмбеддингов. 0 — не ограничивать заранее,
# полагаться только на реакцию при ошибке. Заполните после первых замеров.
INDEXING_EMBED_PER_ITEM_MIB=0

# --------------------------------------------------------------- эмбеддинги
# openai_compatible — Infinity, TEI или vLLM; ollama — запасной вариант; fake — для тестов.
EMBEDDING_PROVIDER=openai_compatible
# Без /v1: Infinity отдаёт OpenAI-совместимые пути в корне.
EMBEDDING_BASE_URL=http://127.0.0.1:7997
# bge-m3 построена на XLM-RoBERTa и понимается любым transformers.
# Qwen3-Embedding здесь не работает: образы Infinity 0.0.76 и 0.0.77 не знают
# архитектуру qwen3 и не стартуют вовсе.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_ENABLED=1
# У bge-m3 обучение симметричное — инструктивный префикс запросу не нужен.
# Для асимметричных моделей (Qwen3-Embedding, e5) впишите префикс сюда.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# ----------------------------------------------------------------- реранкер
RERANKER_ENABLED=1
RERANKER_PROVIDER=infinity
RERANKER_BASE_URL=http://127.0.0.1:7997
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES=30
RERANKER_TOP_N=8

# ---------------------------------------------------------------------- LLM
#
# По умолчанию стоит SGLang, а не Ollama, и это важно не только для скорости.
# Имя модели входит в ключ кэша извлечения. Ollama называет ту же модель
# «qwen3.5:4b», SGLang — «Qwen/Qwen3.5-4B»; кэш, собранный одним, не подходит
# другому. Смена движка без правки имени означает пересчёт стадии графа
# на 72 минуты вместо четырёх, и происходит это молча.
#
# Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1, LLM_MODEL=qwen3.5:4b
# SGLang: LLM_BASE_URL=http://127.0.0.1:8001/v1,  LLM_MODEL=Qwen/Qwen3.5-4B
#
# Замер на RTX 3090: SGLang 2050 фрагментов в час против 1103 у Ollama.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=Qwen/Qwen3.5-4B
LLM_VISION_MODEL=qwen2.5vl:3b
# Пусто = использовать LLM_MODEL
LLM_EXTRACTION_MODEL=
LLM_JUDGE_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=768
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT_SECONDS=300
# Замер bench на RTX 3090: 16 — лучшая точка, 2050 фрагментов в час.
# При 4 получается 2011, при 1 всего 551: выигрыш даёт именно батчинг.
LLM_MAX_CONCURRENCY=16
# Размышление для служебных вызовов (извлечение графа, описание иллюстраций).
# У рассуждающих моделей вроде Qwen3.5 оно съедает весь лимит токенов, и ответ
# приходит пустым — граф получается без связей. Замер на qwen3.5:4b:
# 1962 токена с размышлением против 116 без него при том же результате.
# Пустое значение — не передавать параметр движку.
LLM_REASONING_EFFORT=none
# Для ответов пользователю размышление может быть полезно — задаётся отдельно.
LLM_CHAT_REASONING_EFFORT=

# ------------------------------------------------------- векторное хранилище
QDRANT_PROVIDER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=textbook_chunks
QDRANT_UPSERT_BATCH_SIZE=128
# BM25 на стороне сервера, со стеммингом и стоп-словами русского языка.
QDRANT_SPARSE_ENABLED=1
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_SPARSE_LANGUAGE=russian

# ---------------------------------------------------------------------- граф
GRAPH_ENABLED=1
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_WRITE_BATCH_SIZE=2000
GRAPH_FAIL_ON_ERROR=0

# Построение
GRAPH_EXTRACTOR=llm
GRAPH_EXTRACTION_CACHE_ENABLED=1
GRAPH_EXTRACTION_PROMPT_VERSION=v3
GRAPH_MAX_ENTITIES_PER_CHUNK=12
GRAPH_MAX_RELATIONS_PER_CHUNK=12
GRAPH_LEMMATIZE_ENTITIES=1

# Фильтрация шума. Без неё граф вырождается в клики частотных терминов:
# на прошлом прогоне так получилось 280 526 рёбер CO_OCCURS против 1617 RELATES.
GRAPH_COOCCURRENCE_ENABLED=1
GRAPH_COOCCURRENCE_MIN_PMI=1.0
GRAPH_COOCCURRENCE_MIN_COUNT=2
# Порог отсечения узлов-хабов. Задаёт, сколько фрагментов достижимо обходом:
# при 64 медианный охват — 461 фрагмент из 1151.
#
# Значение 40 подбиралось офлайн-замером второго шага и отклонено проверкой
# на продукте: recall −0.012, у связывающих вопросов −0.029, четыре вопроса
# хуже и ни одного лучше. Причина в том, что отсечение меняет не только обход,
# но и поиск стартовых сущностей по тексту вопроса, а офлайн этого не видит.
GRAPH_MAX_ENTITY_DEGREE=64

# Извлечение. CO_OCCURS в списке типов для расширения запрещён при hops>1.
GRAPH_RETRIEVAL_ENABLED=1
GRAPH_EXPANSION_HOPS=1
GRAPH_EXPANSION_REL_TYPES=RELATES
GRAPH_SEED_ENTITY_LIMIT=20
# Во сколько раз падает вес сущности на каждом шаге обхода. Прежде было зашито
# 1/(1+расстояние), то есть 0.5. Офлайн-замер второго шага предпочитал 0.8,
# на продукте разницы нет (recall −0.003, незначимо). Настройка оставлена
# ради A/B и других корпусов; ноль выключает расширение — так заметно хуже.
GRAPH_HOP_DECAY=0.8
# Взвешивать вклад сущности её редкостью по корпусу. Офлайн выглядело полезным,
# на продукте нейтрально (recall −0.006, незначимо).
GRAPH_PASSAGE_IDF_ENABLED=1
# От чего отталкивается обход графа: query | passages | both.
# `query` — от терминов вопроса. Измерено: канал вырождается в ослабленный
# лексический поиск, его исключительный вклад в контекст равен нулю.
# `passages` — от сущностей уже найденных фрагментов; на многошаговых вопросах
# уникальный вклад вдвое выше, но в абсолютных числах всё ещё мал (0.034).
# `both` — измеренный оптимум: recall 0.840 -> 0.859, вклад графа 0.000 -> 0.023.
GRAPH_SEED_MODE=both
GRAPH_SEED_PASSAGES=3
# Связи, извлекаемые сопоставлением выдержек об одном понятии из разных мест
# книги. Без них любое ребро RELATES соединяет сущности, встретившиеся в одном
# фрагменте, и граф не содержит ничего сверх текста фрагментов.
GRAPH_CROSS_CHUNK_ENABLED=1
# 250 понятий дали прирост recall +0.018; 1200 понятий — +0.015 при вдвое
# большем числе рёбер. Больше не значит лучше: лишние рёбра вносят шум.
GRAPH_CROSS_CHUNK_MAX_ENTITIES=250
GRAPH_CROSS_CHUNK_MIN_CHUNKS=3
GRAPH_PASSAGE_LIMIT=30
GRAPH_WEIGHT=0.4

# -------------------------------------------------------------------- поиск
RETRIEVAL_TOP_K=8
# Размер выдачи для связывающих вопросов. Им нужно два эталонных фрагмента
# вместо одного, поэтому та же квота вмещает вдвое меньше ответов.
# Замер на 172 вопросах полного корпуса: recall многошаговых 0.576 -> 0.729,
# общий 0.826 -> 0.878, средний контекст 8.0 -> 11.2 фрагмента, задержка та же.
# Ноль означает «как у обычных вопросов».
RETRIEVAL_TOP_K_LINKING=16
# Разложение связывающего вопроса на подвопросы. Измерено и отклонено:
# nDCG -0.024, MRR -0.034 при значимых интервалах. Кросс-энкодер на полном
# вопросе точнее, чем два его суждения по половинам. Оставлено выключенным.
RETRIEVAL_DECOMPOSE_ENABLED=0
# Резерв мест в пуле кандидатов реранкера за фрагментами, которые нашёл только
# графовый канал. Без резерва его находки не доезжают до реранкера: замерено,
# что доля таких фрагментов в контексте равнялась нулю при 18% присутствия.
RETRIEVAL_GRAPH_CANDIDATE_QUOTA=6
RETRIEVAL_DENSE_CANDIDATES=40
RETRIEVAL_SPARSE_CANDIDATES=40
RETRIEVAL_FUSION=rrf
RETRIEVAL_RRF_K=60
RETRIEVAL_DEDUP_ENABLED=1
RETRIEVAL_DEDUP_SIMILARITY=0.92
# heuristic — прозрачное правило; llm — модель решает; always/never — для A/B.
RETRIEVAL_ROUTER_ENABLED=1
# Модельный роутер проверен и отклонён. Он отправляет в граф 100% вопросов,
# а маршрут в граф заодно расширяет выдачу с top_k до top_k_linking — весь
# видимый прирост давала выдача. На равном размере выдачи «всегда в граф»
# против эвристики даёт ровно ноль (0/163 изменённых вопросов), а вызов
# модели на каждый вопрос при этом оплачивается.
RETRIEVAL_ROUTER_MODE=heuristic
# Больше нуля — принудительная квота графовых документов в контексте.
# Полезно, чтобы отличить «граф не нашёл» от «граф вытеснен базовым каналом».
RETRIEVAL_MIN_GRAPH_DOCS=0
RETRIEVAL_QUERY_REWRITE_ENABLED=1
RETRIEVAL_MAX_HISTORY_TURNS=3

# ------------------------------------------------------------------- оценка
EVAL_K_VALUES=1,3,5,8,12,16
EVAL_GOLDSET_PATH=evaluation/goldsets/goldset.json
EVAL_MAX_CONCURRENCY=4

# ----------------------------------------------------------------- трейсинг
PHOENIX_ENABLED=0
PHOENIX_ENDPOINT=http://127.0.0.1:4317
PHOENIX_PROTOCOL=grpc
PHOENIX_PROJECT_NAME=rag_textbook

# ------------------------------------------------------------------- сервис
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
SERVICE_REQUEST_TIMEOUT_SECONDS=120
SERVICE_MAX_CONCURRENT_REQUESTS=16
SERVICE_HISTORY_ENABLED=1
SERVICE_HISTORY_DB_PATH=artifacts/state/chat_history.sqlite3

# -------------------------------------------- промпты (можно переопределить)
# QA_SYSTEM_PROMPT=
# CONTEXTUALIZE_Q_SYSTEM_PROMPT=
PROMPT_VERSION=v2

# --- Отбор и порядок выдачи (гипотезы П1-П2, по умолчанию выключены) ---
# Разнообразие выдачи: off | mmr | reserve.
# Основание: все 34 промаха многошаговых вопросов — «нашёл один фрагмент
# из двух». Отбор по одной релевантности не отличает «ещё один фрагмент
# про то же» от «фрагмента про вторую половину вопроса».
RETRIEVAL_DIVERSITY_MODE=off
RETRIEVAL_DIVERSITY_LAMBDA=0.7
RETRIEVAL_DIVERSITY_RESERVE_SLOTS=2
# Режим реранкера: always | by_route | blend | off.
# Основание: реранкер даёт +5 формульных вопросов и отнимает 13 многошаговых.
RERANKER_MODE=always
RERANKER_BLEND_ALPHA=1.0
# Снятие слепка: реранкер оценивает весь пул кандидатов, а не только выдачу.
# Включать только на прогоне со снятием слепка — обычные прогоны это замедляет.
EVAL_TRACE_RERANK_ALL=0
